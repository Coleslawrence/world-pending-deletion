rules_version = '2';
// Firestore access rules for [World Pending Deletion].
// Paste into Firebase console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Each player's private progress: data/users/{uid}/progress
    match /data/users/{uid}/{docId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && docId == 'progress'
        && request.resource.data.keys().hasOnly(['meta', 'run', 'savedAt']);
    }

    // Shared champions: every signed-in player reads them, each player writes only their own document.
    // r is a random key in [0, 1) so the game can read a random handful instead of the whole collection.
    match /champions/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['list', 'name', 'r'])
        && (!('r' in request.resource.data) || (request.resource.data.r is number && request.resource.data.r >= 0 && request.resource.data.r < 1))
        && request.resource.data.list is list && request.resource.data.list.size() <= 12
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 24));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // "Laid to rest" notes, one per document in the champion owner's inbox. Only the owner reads them;
    // any other signed-in player can add a note signed with their own id, never edit one.
    match /inbox/{owner}/notes/{noteId} {
      allow read, delete: if request.auth != null && request.auth.uid == owner;
      allow create: if request.auth != null && request.auth.uid != owner
        && noteId.matches(request.auth.uid + '_[0-9]+')
        && request.resource.data.keys().hasOnly(['by', 'champ', 't', 'name'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.champ is string && request.resource.data.champ.size() <= 60
        && request.resource.data.t is number
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 24));
    }

    // Old "laid to rest" lists, kept so copies of the game from before the inbox still work until they update
    match /rests/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['list', 'name'])
        && request.resource.data.list is list && request.resource.data.list.size() <= 40
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 24));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
